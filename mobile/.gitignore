.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# Gradle writes reports under android/build, which /build/ above does not cover.
**/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Generated from lib/l10n/*.arb by `flutter gen-l10n`, which `flutter pub get`
# runs automatically. The ARB files themselves come from client/src/i18n.ts via
# `npm run i18n:arb` and ARE tracked.
/lib/l10n/app_localizations*.dart
